# AirTable — get from https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Google Calendar — path to service account JSON or inline JSON
GOOGLE_CREDENTIALS_JSON=credentials.json
CALENDAR_RECIPIENT_EMAIL=james@teller.consulting

# FEC API — get from https://api.open.fec.gov/developers/
FEC_API_KEY=your_fec_api_key

# OpenSecrets API — get from https://www.opensecrets.org/api/admin/index.php?function=signup
OPENSECRETS_API_KEY=your_opensecrets_key

# ProPublica Nonprofit Explorer — get from https://www.propublica.org/datastore/api/nonprofit-explorer-api
PROPUBLICA_API_KEY=your_propublica_key

# News API — get from https://newsapi.org/
NEWS_API_KEY=your_news_api_key

# AWS (optional — uses instance role if deployed on AWS)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
