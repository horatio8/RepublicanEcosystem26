# Supabase — get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# FEC API — get from https://api.open.fec.gov/developers/
FEC_API_KEY=your_fec_api_key

# ProPublica Nonprofit Explorer — https://www.propublica.org/datastore/api/nonprofit-explorer-api
PROPUBLICA_API_KEY=your_propublica_key

# News API — get from https://newsapi.org/
NEWS_API_KEY=your_news_api_key

# OpenSecrets API — get from https://www.opensecrets.org/api/admin/index.php?function=signup
OPENSECRETS_API_KEY=your_opensecrets_key

# Google Calendar (for sending invites)
GOOGLE_CREDENTIALS_JSON={}
CALENDAR_RECIPIENT_EMAIL=james@teller.consulting

# Cron secret — set to a random string, used to protect cron endpoints
CRON_SECRET=your_random_secret_here
