{
  "campaign": {
    "name": "Farmers Fightback",
    "website": "https://farmersfightback.com",
    "focus": "Opposition to VNI West transmission line and energy infrastructure overreach affecting Victorian farming communities",
    "region": "Wallaloo, Wimmera, western/central Victoria — with national farming reach",
    "key_issues": [
      "VNI West high-voltage transmission line through prime farmland",
      "Compulsory land access and legislative overreach by VicGrid",
      "Lack of genuine community consultation",
      "Threat to multi-generational farming operations",
      "Biosecurity risks from forced property access",
      "Alternative routes (e.g. Gippsland corridor) not properly considered"
    ],
    "key_people": [
      "Ben Duxson — President, Wallaloo & Gre Gre District Alliance; Kanya merino farmer (Glendemar Multi Purpose Merinos)",
      "Trent Carter — Wallaloo East sheep and cropping farmer, sixth-generation landholder",
      "Mark Reading — Wallaloo fifth-generation farmer, proposed line 600m from home"
    ],
    "allied_organisations": [
      "Wallaloo & Gre Gre District Alliance Inc.",
      "Victorian Farmers Federation (VFF)",
      "National Farmers Federation (NFF)"
    ]
  },
